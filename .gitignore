# =====================================================
# .gitignore - Aplicación Olimpiadas
# =====================================================

# Archivos de configuración con credenciales sensibles
config/
configDB.php

# Archivos Markdown (documentación local)
*.md

# Archivos de sistema
.DS_Store
Thumbs.db

# IDEs y editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log

# Archivos temporales
*.tmp
*.temp
*.swp
*.swo
*~

# Scripts SQL locales (no subir a producción)
sql/crear_usuarios_local.sql
sql/update_deportes_imagen.sql

# Imágenes subidas por usuarios
imagenes/deportes/
