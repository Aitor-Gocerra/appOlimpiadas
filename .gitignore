# =====================================================
# .gitignore - Aplicación Olimpiadas
# =====================================================

# Archivos de configuración con credenciales sensibles
config/
configDB.php

# Archivos Markdown (documentación local)
*.md

# Archivos de sistema
.DS_Store
Thumbs.db

# IDEs y editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log

# Archivos temporales
*.tmp
*.temp
*.swp
*.swo
*~
